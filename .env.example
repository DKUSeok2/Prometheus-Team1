# Upstage API Configuration
# https://console.upstage.ai/에서 발급받은 API 키를 입력하세요
UPSTAGE_API_KEY=your_upstage_api_key_here

# Model Configuration
EMBEDDING_MODEL=solar-embedding-1-large
